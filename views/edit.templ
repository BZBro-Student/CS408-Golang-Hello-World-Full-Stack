package views

import "CS408-Golang-Hello-World-Full-Stack/cmd/web/pages"

templ Edit(p *pages.Page) {
	@Layout(p.Title) {
		<div id="content">
			@PartialEdit(p)
		</div>
	}
}

templ PartialEdit(p *pages.Page) {
	<h1>{ p.Title }:</h1>
	<form hx-post={ "/save/" + p.Title } hx-target="#content" hx-push-url="true">
		<div class="max-w-xl">
			<textarea id="body" name="body" class="w-full h-32 resize p-2 border-2 border-accent-200 px-4 py-2 rounded-lg hover:bg-accent-200/10 transition-colors">{ string(p.Body) }</textarea>
		</div>
		<p>
			<button class="border-2 border-accent-200 px-4 py-2 rounded-lg hover:bg-accent-200/10 transition-colors" type="submit">Save</button>
		</p>
	</form>
}
