package views

import "CS408-Golang-Hello-World-Full-Stack/cmd/web/pages"

templ View(p *pages.Page) {
	@Layout(p.Title) {
		<div id="content">
			@PartialLoad(p)
		</div>
	}
}

templ PartialLoad(p *pages.Page) {
	<h1>{ p.Title }</h1>
	<p>
		<button hx-get={ "/edit/" + p.Title } hx-target="#content" hx-push-url="true">
			Edit
		</button>
	</p>
	<div>
		{ string(p.Body) }
	</div>
}
