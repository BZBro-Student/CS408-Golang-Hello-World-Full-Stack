package views

templ Layout(title string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title }</title>
			<script src="https://unpkg.com/htmx.org@1.9.10"></script>
			<link rel="stylesheet" href="/static/css/output.css"/>
		</head>
		<body class="min-h-screen flex flex-col bg-accent-100">
			<div class="fixed top-0 left-0 right-0 z-50 bg-accent-400 text-accent-300 px-4 py-3 flex items-center justify-between shadow-md font-semibold">
				Hello World! : {title}
			</div>
			<main id="content" class="flex-1 pt-16">
				{ children... }
			</main>
			<footer class="bg-accent-400 text-accent-300 p-4">
				<nav>
					<button class="border-2 border-accent-200 px-4 py-2 rounded-lg hover:bg-accent-200/10 transition-colors" hx-get="/view/homepage" hx-target="#content" hx-push-url="true">
						Home
					</button>
				</nav>
			</footer>
		</body>
	</html>
}
